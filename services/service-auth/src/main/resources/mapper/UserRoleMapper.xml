<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace 必须指向你的 Mapper 接口全限定名 -->
<mapper namespace="com.atguigu.auth.mapper.SysUserRoleMapper">

    <!--
      id：对应接口中的方法名
      resultType：返回值类型，这里写 String（全限定名或别名）
    -->
    <select id="findRoleCodeByUserId" resultType="java.lang.String">
        SELECT role_id FROM sys_user_role ur WHERE ur.user_id = #{userId}
    </select>

</mapper>